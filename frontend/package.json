{
  "name": "apex-pki-ui",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/certificate-map.jsx --bundle --minify --legal-comments=linked --outfile=certificate-map.js && esbuild src/notifications.tsx --jsx=automatic --bundle --minify --legal-comments=linked --outfile=notifications.js",
    "typecheck": "tsc --noEmit --strict --jsx react-jsx --module preserve --target es2022 --skipLibCheck src/notifications.tsx"
  },
  "type": "commonjs",
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
